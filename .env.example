# Скопируйте в .env:  cp .env.example .env   (перед первым запуском docker compose)

# --- PostgreSQL (DWH) ---
POSTGRES_USER=podcast_user
POSTGRES_PASSWORD=example_postgres_password
POSTGRES_DB=podcast_dwh
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- Airflow ---
AIRFLOW_DB=airflow_db
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW_SECRET_KEY=replace_with_random_secret_key

# --- MinIO (Data Lake) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=example_minio_password
MINIO_BUCKET=podcast-lake
MINIO_SECURE=false

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=example_grafana_password

# --- Параметры конвейера ---
SEARCH_TERM=technology
LIMIT=50
LOAD_MODE=incremental        # incremental | full
REQUIRE_TLS=true             # загружать только HTTPS-ленты
MAX_WORKERS=8
MAX_EPISODES_PER_FEED=500

# --- Уведомления (необязательно). Без значений сообщения только пишутся в лог ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
